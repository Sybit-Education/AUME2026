      <bpmn:outgoing>f_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="w_t_self" name="Selbstcheck mit der Checkliste (US-84)">
      <bpmn:incoming>f_4</bpmn:incoming>
      <bpmn:outgoing>f_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="w_eg" name="">
      <bpmn:incoming>f_5</bpmn:incoming>
      <bpmn:outgoing>f_8</bpmn:outgoing>
      <bpmn:outgoing>f_10</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="w_c_cancel" name="Absage erhalten">
