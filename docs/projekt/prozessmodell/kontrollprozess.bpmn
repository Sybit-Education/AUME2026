    <bpmn:messageFlow id="m_6" name="Antwort zum Ergebnis (an Objektbetreuung, CC Sachbearbeitung)" sourceRef="w_t_antw2" targetRef="Part_Seezeit" />
    <bpmn:textAnnotation id="a_1">
      <bpmn:text>Erinnerung 7 Tage und 1 Tag vor Beginn (US-16)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_1_as" sourceRef="w_t_termin" targetRef="a_1" />
    <bpmn:textAnnotation id="a_2">
      <bpmn:text>Stand je Wohnanlage in der Übersicht (US-47)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_2_as" sourceRef="s_t_send" targetRef="a_2" />
    <bpmn:textAnnotation id="a_3">
      <bpmn:text>Bei Abwesenheit übernimmt die Vertretung</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a_3_as" sourceRef="o_t_pruef" targetRef="a_3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_WG" name="Kontrolle aus Sicht der WG" isExecutable="false">
