    <bpmn:endEvent id="w_end_cancel" name="Kontrolle entfällt">
      <bpmn:incoming>f_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="w_c_result" name="Ergebnis verfügbar">
