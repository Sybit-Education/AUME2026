<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Kontrollprozess_R1" targetNamespace="http://seezeit.de/aume/kontrollprozess" exporter="AUME2026" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_R1">
    <bpmn:participant id="Part_WG" name="WG / Studierende" processRef="Process_WG" />
    <bpmn:participant id="Part_Seezeit" name="Seezeit" processRef="Process_Seezeit" />
    <bpmn:messageFlow id="m_1" name="Ankündigung" sourceRef="s_t_ank" targetRef="w_start" />
    <bpmn:messageFlow id="m_3" name="Absage" sourceRef="s_end_del" targetRef="w_c_cancel" />
    <bpmn:messageFlow id="m_4" name="Protokoll" sourceRef="o_t_prot" targetRef="w_c_result" />
