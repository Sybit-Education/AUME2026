      <bpmn:outgoing>f_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="w_start_ed" />
    </bpmn:startEvent>
    <bpmn:userTask id="w_t_termin" name="Termin und Status ansehen (US-15, US-67)">
      <bpmn:incoming>f_1</bpmn:incoming>
      <bpmn:outgoing>f_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="w_t_prep" name="Checkliste, Erklärungen, Ablauf lesen (US-21, US-22, US-23)">
