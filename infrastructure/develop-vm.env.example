# Fine-grained PAT nur für dieses Repository, Berechtigung Contents: Read and write.
# Eine Zeile. Watchtower sendet sie, wenn ein Container-Image gewechselt hat.
# Die echte Datei heißt develop-vm.env und wird nicht eingecheckt.
WATCHTOWER_NOTIFICATION_URL=generic://api.github.com/repos/Sybit-Education/AUME2026/dispatches?@authorization=Bearer%20TOKEN&@accept=application/vnd.github%2Bjson&@x-github-api-version=2022-11-28
