# Profil prod. Staging lässt SEEZEIT_TAG weg oder setzt staging. Produktion pinnt den Release-Tag.
# SEEZEIT_TAG=v1.2.0
# Für den Betrieb ohne dev-Profil; an den eigenen Keycloak anpassen.
# Echte Werte gehören in .env und werden nicht eingecheckt.
KEYCLOAK_URL=https://identity.example.org
KEYCLOAK_REALM=seezeit
KEYCLOAK_CLIENT_ID=seezeit-frontend
KEYCLOAK_ISSUER_URI=https://identity.example.org/realms/seezeit
KEYCLOAK_AUDIENCE=seezeit-api
